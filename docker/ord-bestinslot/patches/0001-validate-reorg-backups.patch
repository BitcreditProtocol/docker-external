index 0000000..6a9371b
--- /dev/null
+++ b/ord/src/index/reorg/backups.rs
@@ -0,0 +1,644 @@
+use super::*;
+
+const STAGING: &str = "index.db.reorg-restore";
+const PREVIOUS: &str = "index.db.reorg-previous";
+const HINTS: &str = "checkpoint-tips.json";
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+struct Tip {
+  height: u32,
+  hash: BlockHash,
+}
+
+#[derive(Deserialize, Serialize)]
+struct Hint {
+  // Bind the hint to the immutable RocksDB backup manifest, not just its ID.
+  manifest_hash: String,
+  tip: Option<Tip>,
+}
+
+type Hints = BTreeMap<u32, Hint>;
+
+fn read_hints(path: &Path) -> Result<Hints> {
+  let file = path.join("backup").join(HINTS);
+  match fs::read(&file) {
+    Ok(bytes) => match serde_json::from_slice(&bytes) {
+      Ok(hints) => Ok(hints),
+      Err(err) => {
+        log::warn!(
+          "Ignoring malformed checkpoint hints at {}: {err}",
+          file.display()
+        );
+        Ok(Hints::new())
+      }
+    },
+    Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(Hints::new()),
+    Err(err) => Err(err.into()),
+  }
+}
+
+fn write_hints(path: &Path, hints: &Hints) -> Result {
+  let directory = path.join("backup");
+  let mut file = tempfile::NamedTempFile::new_in(&directory)?;
+  serde_json::to_writer(file.as_file_mut(), hints)?;
+  file.as_file().sync_all()?;
+  file.persist(directory.join(HINTS))?;
+  File::open(directory)?.sync_all()?;
+  Ok(())
+}
+
+fn manifest_hash(path: &Path, id: u32) -> Result<String> {
+  Ok(
+    bitcoin::hashes::sha256::Hash::hash(&fs::read(
+      path.join("backup").join("meta").join(id.to_string()),
+    )?)
+    .to_string(),
+  )
+}
+
+fn tip(db: &DB) -> Result<Option<Tip>> {
+  let cf = db
+    .cf_handle("height_to_block_header")
+    .ok_or_else(|| anyhow!("Missing checkpoint column family height_to_block_header"))?;
+  db.iterator_cf(cf, IteratorMode::End)
+    .next()
+    .transpose()?
+    .map(|(height, header)| {
+      Ok(Tip {
+        height: u32::from_be_bytes(
+          height
+            .as_ref()
+            .try_into()
+            .context("Invalid checkpoint height")?,
+        ),
+        hash: consensus::encode::deserialize::<Header>(&header)?.block_hash(),
+      })
+    })
+    .transpose()
+}
+
+fn restored_tip(path: &Path) -> Result<Option<Tip>> {
+  let options = Options::default();
+  let families = DB::list_cf(&options, path)?;
+  let db = DB::open_cf_for_read_only(&options, path, families, false)?;
+  tip(&db)
+}
+
+pub(super) fn remember_new_backup(path: &Path, engine: &BackupEngine, db: &DB) -> Result {
+  let id = engine
+    .get_backup_info()
+    .into_iter()
+    .map(|info| info.backup_id)
+    .max()
+    .ok_or_else(|| anyhow!("New checkpoint is missing from backup engine"))?;
+  let mut hints = read_hints(path)?;
+  hints.insert(
+    id,
+    Hint {
+      manifest_hash: manifest_hash(path, id)?,
+      tip: tip(db)?,
+    },
+  );
+  write_hints(path, &hints)
+}
+
+pub(super) fn prune_hints(path: &Path, engine: &BackupEngine) -> Result {
+  let ids: HashSet<_> = engine
+    .get_backup_info()
+    .into_iter()
+    .map(|info| info.backup_id)
+    .collect();
+  let mut hints = read_hints(path)?;
+  hints.retain(|id, _| ids.contains(id));
+  write_hints(path, &hints)
+}
+
+fn directory_exists(path: &Path) -> Result<bool> {
+  match fs::symlink_metadata(path) {
+    Ok(metadata) => {
+      ensure!(
+        metadata.file_type().is_dir(),
+        "Expected a directory at {}",
+        path.display()
+      );
+      Ok(true)
+    }
+    Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(false),
+    Err(err) => Err(err.into()),
+  }
+}
+
+fn remove_directory(path: &Path) -> Result {
+  if directory_exists(path)? {
+    fs::remove_dir_all(path)?;
+  }
+  Ok(())
+}
+
+fn lock(path: &Path) -> Result<DB> {
+  fs::create_dir_all(path)?;
+  let mut options = Options::default();
+  options.create_if_missing(true);
+  // RocksDB's OS lock is released on process exit. Hold it through both normal
+  // indexing and recovery so startup cleanup cannot race a live directory swap.
+  DB::open(&options, path.join("reorg.lock"))
+    .context("Could not acquire Ord recovery lock; another process may be using this index")
+}
+
+pub(super) fn prepare_index(path: &Path) -> Result<DB> {
+  let guard = lock(path)?;
+  finish_interrupted_restore(path)?;
+  Ok(guard)
+}
+
+fn finish_interrupted_restore(path: &Path) -> Result {
+  let current = path.join("index.db");
+  let previous = path.join(PREVIOUS);
+  if directory_exists(&previous)? {
+    if !directory_exists(&current)? {
+      // The process stopped between renaming the old index and installing the new one.
+      fs::rename(&previous, &current)?;
+      File::open(path)?.sync_all()?;
+    } else {
+      remove_directory(&previous)?;
+    }
+  }
+  remove_directory(&path.join(STAGING))
+}
+
+fn canonical(
+  tip: &Option<Tip>,
+  hash_at: &mut impl FnMut(u32) -> Result<Option<BlockHash>>,
+) -> Result<bool> {
+  match tip {
+    Some(tip) => Ok(
+      hash_at(tip.height).context("Could not validate checkpoint against Bitcoin Core")?
+        == Some(tip.hash),
+    ),
+    None => Ok(false),
+  }
+}
+
+pub(super) fn restore(
+  path: &Path,
+  mut hash_at: impl FnMut(u32) -> Result<Option<BlockHash>>,
+) -> Result {
+  let _recovery_lock = prepare_index(path)?;
+  let mut engine = BackupEngine::open(
+    &BackupEngineOptions::new(path.join("backup"))?,
+    &rocksdb::Env::new()?,
+  )?;
+  let mut backups = engine.get_backup_info();
+  backups.sort_by_key(|info| std::cmp::Reverse(info.backup_id));
+  let mut hints = read_hints(path)?;
+  let staging = path.join(STAGING);
+
+  for backup in backups {
+    let id = backup.backup_id;
+    let fingerprint = manifest_hash(path, id)?;
+    if let Some(hint) = hints
+      .get(&id)
+      .filter(|hint| hint.manifest_hash == fingerprint)
+    {
+      // A hint can reject a candidate cheaply, but can never authorize promotion.
+      // Recheck Core every time: a previously orphaned branch may become active again.
+      if !canonical(&hint.tip, &mut hash_at)? {
+        println!("skipping backup {id}: checkpoint is not on Bitcoin Core's active chain");
+        continue;
+      }
+    }
+
+    println!("checking backup with id {id}");
+    remove_directory(&staging)?;
+    engine.restore_from_backup(
+      &staging,
+      &staging,
+      &rocksdb::backup::RestoreOptions::default(),
+      id,
+    )?;
+    let actual_tip = restored_tip(&staging)?;
+    hints.insert(
+      id,
+      Hint {
+        manifest_hash: fingerprint,
+        tip: actual_tip.clone(),
+      },
+    );
+    // Persist the probe before RPC validation so even an interrupted attempt need not
+    // restore this checkpoint again just to discover its height/hash.
+    write_hints(path, &hints)?;
+    if !canonical(&actual_tip, &mut hash_at)? {
+      remove_directory(&staging)?;
+      continue;
+    }
+
+    let current = path.join("index.db");
+    let previous = path.join(PREVIOUS);
+    ensure!(directory_exists(&current)?, "Current Ord index is missing");
+    fs::rename(&current, &previous)?;
+    File::open(path)?.sync_all()?;
+    if let Err(err) = fs::rename(&staging, &current) {
+      fs::rename(&previous, &current)?;
+      return Err(err.into());
+    }
+    File::open(path)?.sync_all()?;
+    remove_directory(&previous)?;
+    println!("successfully rolled back database using canonical backup {id}");
+    return Ok(());
+  }
+
+  bail!("No valid Ord backup matches Bitcoin Core's active chain; current index and backups were preserved")
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  fn headers(branch: u32, count: u32) -> Vec<Header> {
+    let genesis = bitcoin::blockdata::constants::genesis_block(Network::Regtest).header;
+    let mut result = vec![genesis];
+    for height in 1..count {
+      let mut header = genesis;
+      header.prev_blockhash = result.last().unwrap().block_hash();
+      header.time += height;
+      header.nonce = branch * 1000 + height;
+      result.push(header);
+    }
+    result
+  }
+
+  fn database(path: &Path) -> DB {
+    let mut options = Options::default();
+    options.create_if_missing(true);
+    options.create_missing_column_families(true);
+    DB::open_cf(
+      &options,
+      path,
+      [
+        "height_to_block_header",
+        "statistic_to_count",
+        "outpoint_to_utxo_entry",
+      ],
+    )
+    .unwrap()
+  }
+
+  fn write_chain(db: &DB, headers: &[Header]) {
+    let cf = db.cf_handle("height_to_block_header").unwrap();
+    let mut options = rocksdb::WriteOptions::default();
+    options.disable_wal(true);
+    for (height, header) in headers.iter().enumerate() {
+      db.put_cf_opt(
+        cf,
+        u32::try_from(height).unwrap().to_be_bytes(),
+        header.store(),
+        &options,
+      )
+      .unwrap();
+    }
+    // A legacy checkpoint can contain a stale statistic unrelated to its actual tip.
+    db.put_cf_opt(
+      db.cf_handle("statistic_to_count").unwrap(),
+      Statistic::LastSavepointHeight.key().to_be_bytes(),
+      1u32.to_be_bytes(),
+      &options,
+    )
+    .unwrap();
+    db.put_cf_opt(
+      db.cf_handle("outpoint_to_utxo_entry").unwrap(),
+      b"fixture-utxo",
+      headers.last().unwrap().block_hash().to_byte_array(),
+      &options,
+    )
+    .unwrap();
+  }
+
+  fn engine(path: &Path) -> BackupEngine {
+    BackupEngine::open(
+      &BackupEngineOptions::new(path.join("backup")).unwrap(),
+      &rocksdb::Env::new().unwrap(),
+    )
+    .unwrap()
+  }
+
+  fn fixture(chain: &[Header]) -> tempfile::TempDir {
+    let directory = tempfile::tempdir().unwrap();
+    let db = database(&directory.path().join("index.db"));
+    write_chain(&db, chain);
+    engine(directory.path())
+      .create_new_backup_flush(&db, true)
+      .unwrap();
+    directory
+  }
+
+  fn hash_at(chain: &[Header], height: u32) -> Result<Option<BlockHash>> {
+    Ok(
+      chain
+        .get(usize::try_from(height).unwrap())
+        .map(Header::block_hash),
+    )
+  }
+
+  fn current_tip(path: &Path) -> Tip {
+    restored_tip(&path.join("index.db")).unwrap().unwrap()
+  }
+
+  fn current_payload(path: &Path) -> Vec<u8> {
+    let db = database(&path.join("index.db"));
+    db.get_cf(
+      db.cf_handle("outpoint_to_utxo_entry").unwrap(),
+      b"fixture-utxo",
+    )
+    .unwrap()
+    .unwrap()
+  }
+
+  #[test]
+  fn stale_old_checkpoint_does_not_hide_newer_canonical_checkpoint() {
+    let core = mockcore::builder().network(Network::Regtest).build();
+    let client = Client::new(&core.url(), bitcoincore_rpc::Auth::None).unwrap();
+    let genesis = client
+      .get_block_header(&client.get_block_hash(0).unwrap())
+      .unwrap();
+    let mut branch_a = vec![genesis];
+    branch_a.extend(core.mine_blocks(6).into_iter().map(|block| block.header));
+    let directory = fixture(&branch_a);
+    let path = directory.path();
+    for _ in 0..6 {
+      core.invalidate_tip();
+    }
+    let mut branch_b = vec![genesis];
+    branch_b.extend(core.mine_blocks(12).into_iter().map(|block| block.header));
+    {
+      let db = database(&path.join("index.db"));
+      write_chain(&db, &branch_b[..11]);
+      engine(path).create_new_backup_flush(&db, true).unwrap();
+      write_chain(&db, &branch_b);
+    }
+    // Both legacy backups have no sidecar. The valid checkpoint is beyond the
+    // mismatch at branch A's height 7, and its LastSavepointHeight still says 1.
+    Reorg::handle_reorg(path, &client, 7, 2).unwrap();
+    assert_eq!(
+      current_tip(path),
+      Tip {
+        height: 10,
+        hash: branch_b[10].block_hash()
+      }
+    );
+    assert_eq!(engine(path).get_backup_info().len(), 2);
+    assert_eq!(
+      current_payload(path),
+      branch_b[10].block_hash().to_byte_array()
+    );
+  }
+
