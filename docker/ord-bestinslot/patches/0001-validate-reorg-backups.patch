+
+  #[test]
+  fn all_orphans_preserve_active_index_and_are_skipped_after_restart() {
+    let branch_a = headers(1, 7);
+    let branch_b = headers(2, 10);
+    let directory = fixture(&branch_a);
+    let path = directory.path();
+    {
+      let db = database(&path.join("index.db"));
+      write_chain(&db, &branch_b);
+    }
+    let expected = current_tip(path);
+    let expected_payload = current_payload(path);
+    let error = restore(path, |height| hash_at(&branch_b, height)).unwrap_err();
+    assert!(error.to_string().contains("No valid Ord backup"));
+    assert_eq!(current_tip(path), expected);
+    assert_eq!(current_payload(path), expected_payload);
+    // A fresh engine/hints load models a process restart. A probe always writes
+    // its hint atomically, so unchanged inode identity proves no second probe.
+    #[cfg(unix)]
+    let hint_inode = {
+      use std::os::unix::fs::MetadataExt;
+      fs::metadata(path.join("backup").join(HINTS)).unwrap().ino()
+    };
+    let error = restore(path, |height| hash_at(&branch_b, height)).unwrap_err();
+    assert!(
+      error.to_string().contains("No valid Ord backup"),
+      "{error:#}"
+    );
+    assert_eq!(current_tip(path), expected);
+    assert_eq!(current_payload(path), expected_payload);
+    assert_eq!(engine(path).get_backup_info().len(), 1);
+    #[cfg(unix)]
+    {
+      use std::os::unix::fs::MetadataExt;
+      assert_eq!(
+        fs::metadata(path.join("backup").join(HINTS)).unwrap().ino(),
+        hint_inode
+      );
+    }
+  }
+
+  #[test]
+  fn rpc_failure_on_final_validation_leaves_active_index_and_backup_intact() {
+    let chain = headers(1, 7);
+    let directory = fixture(&chain[..4]);
+    let path = directory.path();
+    {
+      let db = database(&path.join("index.db"));
