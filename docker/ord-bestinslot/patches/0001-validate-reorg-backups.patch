+      read_hints(path).unwrap()[&1].tip.as_ref().unwrap().height,
+      6
+    );
+  }
+
+  #[test]
+  fn new_checkpoint_flushes_wal_disabled_writes_and_records_actual_tip() {
+    let chain = headers(1, 7);
+    let directory = fixture(&chain[..3]);
+    let path = directory.path();
+    {
+      let db = database(&path.join("index.db"));
+      write_chain(&db, &chain);
+      let mut engine = engine(path);
+      engine.create_new_backup_flush(&db, true).unwrap();
+      remember_new_backup(path, &engine, &db).unwrap();
+      engine.purge_old_backups(1).unwrap();
+      prune_hints(path, &engine).unwrap();
+    }
+    let hints = read_hints(path).unwrap();
+    assert_eq!(hints.len(), 1);
+    assert_eq!(
+      hints[&2].tip,
+      Some(Tip {
+        height: 6,
+        hash: chain[6].block_hash()
+      })
+    );
+    restore(path, |height| hash_at(&chain, height)).unwrap();
+    assert_eq!(current_tip(path).height, 6);
+  }
+
+  #[test]
+  fn interrupted_swap_recovers_previous_index_before_empty_database_can_be_created() {
+    let chain = headers(1, 7);
+    let directory = fixture(&chain);
+    let path = directory.path();
+    fs::rename(path.join("index.db"), path.join(PREVIOUS)).unwrap();
+    fs::create_dir(path.join(STAGING)).unwrap();
+    fs::write(path.join(STAGING).join("incomplete"), b"partial restore").unwrap();
+    finish_interrupted_restore(path).unwrap();
+    assert_eq!(current_tip(path).height, 6);
+    assert!(!path.join(PREVIOUS).exists());
+    assert!(!path.join(STAGING).exists());
+  }
+
+  #[test]
+  fn interrupted_cleanup_keeps_promoted_index() {
+    let branch_a = headers(1, 7);
+    let branch_b = headers(2, 10);
+    let directory = fixture(&branch_a);
+    let path = directory.path();
+    fs::rename(path.join("index.db"), path.join(PREVIOUS)).unwrap();
+    {
+      let db = database(&path.join("index.db"));
+      write_chain(&db, &branch_b);
+    }
+    finish_interrupted_restore(path).unwrap();
+    assert_eq!(current_tip(path).hash, branch_b[9].block_hash());
+    assert!(!path.join(PREVIOUS).exists());
+  }
+
+  #[test]
+  fn another_process_cannot_clean_up_a_live_recovery() {
+    let chain = headers(1, 7);
+    let directory = fixture(&chain);
+    let path = directory.path();
+    let guard = lock(path).unwrap();
+    fs::create_dir(path.join(STAGING)).unwrap();
+    fs::write(path.join(STAGING).join("sentinel"), b"live restore").unwrap();
+    assert!(prepare_index(path).is_err());
+    assert_eq!(
+      fs::read(path.join(STAGING).join("sentinel")).unwrap(),
+      b"live restore"
+    );
+    drop(guard);
+    let _guard = prepare_index(path).unwrap();
+    assert!(!path.join(STAGING).exists());
+    assert_eq!(current_tip(path).height, 6);
+  }
+
+  #[cfg(unix)]
+  #[test]
+  fn unexpected_staging_symlink_fails_closed() {
+    let chain = headers(1, 7);
+    let directory = fixture(&chain);
+    let path = directory.path();
+    let unrelated = path.join("unrelated");
+    fs::create_dir(&unrelated).unwrap();
+    fs::write(unrelated.join("sentinel"), b"preserve").unwrap();
+    std::os::unix::fs::symlink(&unrelated, path.join(STAGING)).unwrap();
+    assert!(prepare_index(path).is_err());
+    assert_eq!(fs::read(unrelated.join("sentinel")).unwrap(), b"preserve");
+    assert_eq!(current_tip(path).height, 6);
+  }
+}
